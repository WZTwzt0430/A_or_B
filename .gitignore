# ------------------------------------------------------------
#  A_or_B  .gitignore
#  交付物：源码 + 脚本 + 文档 + 第三方头文件
#  产物（bin\ build\ dist\）不入库，由构建和打包脚本生成
# ------------------------------------------------------------

# ---- 构建产物 ----
/build/
/bin/
/dist/
*.obj
*.pdb
*.ilk
*.exp
*.lib

# ---- 运行期数据 ----
/data/
/logs/

# ---- 历史快照 ----
# 版本历史由 git 提交记录承担；旧版本通过 PR 逐个补进仓库后，
# versions/ 目录即可删除。过渡期先不入库。
/versions/

# ---- 编辑器 / IDE ----
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb

# 含本机绝对路径（MSVC / Windows SDK 安装位置），不适合共享
.vscode/c_cpp_properties.json

# ---- 临时文件 ----
*.tmp
*.log
Thumbs.db
desktop.ini
